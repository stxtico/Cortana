# PROMPTS.md A24 - tools/write_docx.py etc.'s real output (documents,
# spreadsheets, presentations, PDFs the user actually asked for) - stays
# out of git for the same reason marketing_out/ does: generated deliverable
# content, not project source.
deliverables/

# Synthetic, mechanically regenerable from cad/verified/ + scripts/cad_synth.py
# (PROMPTS.md A13) - unlike cad/verified/ itself (hand-authored scripts,
# descriptions, and real failed-attempt history), this is derived output that
# only grows with each synth run, same "generated state stays out of git"
# pattern as logs/, memory_store/, daemon_store/ above.
cad/dataset.jsonl

# tools/cad.py's working output (PROMPTS.md A14) - draft iterations, renders,
# and exports for parts still being generated/refined. Promote a good result
# into cad/verified/ via scripts/cad_log.py add-part if it should be kept;
# this directory itself is scratch, same spirit as cad/dataset.jsonl above.
cad/generated/

# Third-party free Live2D placeholder rig + Cubism runtime (PROMPTS.md A15) -
# fetched by scripts/fetch_live2d_placeholder.py, same reason voice_source/ is
# gitignored above: content this project uses locally but didn't author and
# doesn't redistribute through its own git history. Reproducible - rerun the
# fetch script, not a manual one-off download.
ui/assets/live2d/